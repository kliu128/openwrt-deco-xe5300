From: Kevin Liu <11365056+kliu128@users.noreply.github.com>
Subject: [PATCH] remoteproc: qcom_q6v5_mpd: restart the user pds after a crash

A fatal error of the Q6 is reported for the root pd only. The remoteproc
core then stops and starts the root pd, but the user pds, which died with
it, stay marked as running: what was set up for them is never released and
nothing spawns them again, so the radios stay dead until a reboot.

When the root pd is stopped after a crash, release the user pds as a
regular stop would have done. Once the root pd runs again, load and spawn
them again, one after the other as at boot.

The firmware needs a few seconds after a fatal error before a user pd can
be spawned again; spawned earlier it takes an exception while it
initialises. The internal radio is left powered while the root pd restarts
because ath11k still services its interrupts and reading its registers
after qcom_scm_internal_wifi_shutdown() raises an SError.

The user pd table is indexed by the pd asid, which runs from 1 to MAX_UPD,
so it needs one more entry.

Signed-off-by: Kevin Liu <11365056+kliu128@users.noreply.github.com>
---
--- a/drivers/remoteproc/qcom_q6v5_mpd.c
+++ b/drivers/remoteproc/qcom_q6v5_mpd.c
@@ -73,6 +73,15 @@
 	u32 data_size;
 } __packed;
 
+/*
+ * After a fatal error the Q6 firmware needs a few seconds before the user pd
+ * that failed can be spawned again: spawned earlier, that user pd takes an
+ * exception while it initialises. At boot the user pds also come up one
+ * radio at a time.
+ */
+#define Q6_RESPAWN_DELAY_MS	5000
+#define Q6_RESPAWN_GAP_MS	2000
+
 struct q6_wcss {
 	struct device *dev;
 	struct qcom_rproc_glink glink_subdev;
@@ -86,7 +95,10 @@
 	int num_clks;
 	const struct wcss_data *desc;
 	const char **firmware;
-	struct userpd *upd[MAX_UPD];
+	/* indexed by pd asid, which runs from 1 to MAX_UPD */
+	struct userpd *upd[MAX_UPD + 1];
+	struct delayed_work respawn_work;
+	unsigned int crash_gen;
 };
 
 struct userpd {
@@ -94,8 +106,13 @@
 	struct device *dev;
 	struct qcom_rproc_ssr ssr_subdev;
 	struct qcom_q6v5 q6;
+	/* torn down with a crashed root pd, to be spawned again once it is back */
+	bool respawn;
 };
 
+static void q6_wcss_teardown_upds(struct rproc *rproc);
+static bool q6_wcss_respawn_pending(struct q6_wcss *wcss);
+
 struct wcss_data {
 	u32 pasid;
 	bool share_upd_info_to_q6;
@@ -135,6 +152,14 @@
 	if (ret == -ETIMEDOUT)
 		dev_err(wcss->dev, "start timed out\n");
 
+	/*
+	 * The root pd is back after a crash: spawn the user pds that went
+	 * down with it, once the core has finished starting the root pd.
+	 */
+	if (!ret && q6_wcss_respawn_pending(wcss))
+		mod_delayed_work(system_wq, &wcss->respawn_work,
+				 msecs_to_jiffies(Q6_RESPAWN_DELAY_MS));
+
 	return ret;
 }
 
@@ -205,6 +230,14 @@
 		dev_err(wcss->dev, "pd not stopped\n");
 		return ret;
 	}
+
+	/*
+	 * A fatal error of the Q6 is reported for the root pd only, while the
+	 * user pds die with it. Release what was set up for them before the
+	 * root pd is shut down, as a regular user pd stop would have done.
+	 */
+	if (rproc->state == RPROC_CRASHED)
+		q6_wcss_teardown_upds(rproc);
 
 	ret = qcom_scm_pas_shutdown(desc->pasid);
 	if (ret) {
@@ -522,8 +555,152 @@
 			     wcss->desc->pasid, upd->pd_asid, wcss->mem_region,
 			     wcss->mem_phys, wcss->mem_size,
 			     NULL);
+}
+
+static bool q6_wcss_respawn_pending(struct q6_wcss *wcss)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(wcss->upd); i++)
+		if (wcss->upd[i] && wcss->upd[i]->respawn)
+			return true;
+
+	return false;
 }
 
+/**
+ * q6_wcss_teardown_upds() - release the user pds of a crashed root pd
+ * @rproc:	root pd rproc handle
+ *
+ * Called while the crashed root pd is being stopped. The user pds cannot be
+ * asked to stop any more; undo what wcss_pd_start() did on the host and
+ * TrustZone side and remember which of them have to be spawned again.
+ */
+static void q6_wcss_teardown_upds(struct rproc *rproc)
+{
+	struct q6_wcss *wcss = rproc->priv;
+	const struct wcss_data *desc = wcss->desc;
+	struct userpd *upd;
+	u32 pasid;
+	int i, ret;
+
+	/* tells a respawn that is under way to stop */
+	WRITE_ONCE(wcss->crash_gen, wcss->crash_gen + 1);
+
+	for (i = 0; i < ARRAY_SIZE(wcss->upd); i++) {
+		upd = wcss->upd[i];
+		if (!upd || upd->q6.rproc->state != RPROC_RUNNING)
+			continue;
+
+		upd->q6.running = false;
+		upd->respawn = true;
+
+		/*
+		 * The internal radio is left powered: ath11k is still
+		 * servicing its interrupts at this point, and reading its
+		 * registers after qcom_scm_internal_wifi_shutdown() raises an
+		 * SError.
+		 */
+
+		if (!(desc->skip_msa_lock_internal_radio && upd->pd_asid == 1)) {
+			pasid = (upd->pd_asid << 8) | UPD_SWID;
+			ret = qcom_scm_msa_unlock(pasid);
+			if (ret)
+				dev_err(upd->dev, "failed to power down pd: %d\n", ret);
+		}
+
+		dev_info(upd->dev, "user pd %d released after root pd crash\n",
+			 upd->pd_asid);
+	}
+}
+
+/**
+ * q6_wcss_respawn_work() - spawn the user pds again after a root pd recovery
+ * @work:	work handle
+ *
+ * The user pd rprocs stay registered as running across a root pd crash, so
+ * nothing else would load and spawn them again.
+ */
+static void q6_wcss_respawn_work(struct work_struct *work)
+{
+	struct q6_wcss *wcss = container_of(to_delayed_work(work),
+					    struct q6_wcss, respawn_work);
+	struct rproc *rpd_rproc = wcss->q6.rproc;
+	const struct firmware *fw;
+	struct rproc *urproc;
+	struct userpd *upd;
+	unsigned int gen = READ_ONCE(wcss->crash_gen);
+	int i, ret;
+
+	/* wait for the core to finish starting the root pd */
+	for (i = 0; i < 50 && rpd_rproc->state != RPROC_RUNNING; i++)
+		msleep(100);
+
+	if (rpd_rproc->state != RPROC_RUNNING) {
+		dev_err(wcss->dev, "root pd not running, user pds not spawned\n");
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(wcss->upd); i++) {
+		upd = wcss->upd[i];
+		if (!upd || !upd->respawn)
+			continue;
+
+		/* crashed again: the next root pd start spawns them */
+		if (gen != READ_ONCE(wcss->crash_gen) ||
+		    rpd_rproc->state != RPROC_RUNNING)
+			return;
+
+		urproc = upd->q6.rproc;
+		mutex_lock(&urproc->lock);
+		upd->respawn = false;
+
+		if (urproc->state != RPROC_RUNNING) {
+			mutex_unlock(&urproc->lock);
+			continue;
+		}
+
+		ret = request_firmware(&fw, urproc->firmware, upd->dev);
+		if (ret) {
+			dev_err(upd->dev, "request_firmware failed: %d\n", ret);
+			mutex_unlock(&urproc->lock);
+			continue;
+		}
+
+		ret = qcom_mdt_load_pd_seg(upd->dev, fw, urproc->firmware,
+					   wcss->desc->pasid, upd->pd_asid,
+					   wcss->mem_region, wcss->mem_phys,
+					   wcss->mem_size, NULL);
+		release_firmware(fw);
+		if (ret) {
+			dev_err(upd->dev, "failed to load user pd %d: %d\n",
+				upd->pd_asid, ret);
+			mutex_unlock(&urproc->lock);
+			continue;
+		}
+
+		reinit_completion(&upd->q6.start_done);
+		reinit_completion(&upd->q6.stop_done);
+		reinit_completion(&upd->q6.spawn_done);
+
+		ret = wcss_pd_start(urproc);
+		if (ret)
+			dev_err(upd->dev, "failed to spawn user pd %d again: %d\n",
+				upd->pd_asid, ret);
+		else
+			dev_info(upd->dev, "user pd %d spawned again\n",
+				 upd->pd_asid);
+
+		mutex_unlock(&urproc->lock);
+
+		/*
+		 * At boot the user pds come up one radio at a time. Give
+		 * each one time to initialise before the next is spawned.
+		 */
+		msleep(Q6_RESPAWN_GAP_MS);
+	}
+}
+
 static unsigned long q6_wcss_panic(struct rproc *rproc)
 {
 	struct q6_wcss *wcss = rproc->priv;
@@ -791,6 +968,7 @@
 	wcss->dev = &pdev->dev;
 	wcss->desc = of_device_get_match_data(&pdev->dev);
 	wcss->firmware = firmware;
+	INIT_DELAYED_WORK(&wcss->respawn_work, q6_wcss_respawn_work);
 
 	ret = q6_alloc_memory_region(wcss);
 	if (ret)
@@ -845,6 +1023,7 @@
 	struct rproc *rproc = platform_get_drvdata(pdev);
 	struct q6_wcss *wcss = rproc->priv;
 
+	cancel_delayed_work_sync(&wcss->respawn_work);
 	qcom_q6v5_deinit(&wcss->q6);
 
 	rproc_del(rproc);
